# Copy to .env and fill in. Never commit .env.
LLM_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=        # with LLM_MODEL=openai:...       (uv sync --extra openai)
# GOOGLE_API_KEY=        # with LLM_MODEL=google_genai:... (uv sync --extra google)

# Cost telemetry: USD per 1M tokens for the model above (check your provider's price list).
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

API_KEYS=dev-key:demo-user
RATE_LIMIT_PER_MINUTE=30

RERANK_ENABLED=false
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.93
